<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <main
      class="d-flex justify-content-center align-items-center min-vh-100 p-3"
    >
      <div class="w-100" style="max-width: 22rem">
        <h3 class="mb-2">Forgot password</h3>
        <p class="mb-4">
          Enter your email and we'll send you a link to reset your password.
        </p>

        <form action="/api/auth/forgot-password" method="POST">
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              class="form-control"
              required
              autofocus
            />
          </div>
          <button type="submit" class="btn btn-primary theme-primary w-100">
            Send reset link
          </button>
        </form>
      </div>
    </main>
  </body>
</html>
