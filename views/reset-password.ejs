<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <main
      class="d-flex justify-content-center align-items-center min-vh-100 p-3"
    >
      <div class="w-100" style="max-width: 22rem">
        <h3 class="mb-2">Reset password for <%= email %></h3>
        <p class="mb-4">Enter new password.</p>

        <form action="" method="POST">
          <div class="mb-3">
            <label for="password" class="form-label">New Password</label>
            <input
              type="password"
              name="password"
              id="password"
              class="form-control"
              required
              autofocus
            />
          </div>
          <button type="submit" class="btn btn-primary theme-primary w-100">
            Reset Password
          </button>
        </form>
      </div>
    </main>
  </body>
</html>
